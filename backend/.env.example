# Database — use PostGIS instance (example: Docker on port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/blinkit?schema=public
DEFAULT_STORE_ID=

# Cache / Queue
REDIS_URL=redis://localhost:6379

# Search
OPENSEARCH_ENDPOINT=http://localhost:9200

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_ADMIN_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d
GOOGLE_CLIENT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AWS — S3 (no VPC required; use host DATABASE_URL for Postgres)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
SES_FROM_EMAIL=
SNS_SENDER_ID=
SECRETS_MANAGER_SECRET_NAME=

# Audit logs — auto-delete after N days (default 5)
AUDIT_RETENTION_DAYS=5

# Auth token expiry
JWT_ACCESS_EXPIRY=15m
JWT_ADMIN_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=30d

# Payments
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# Maps
MAPS_API_KEY=

# WhatsApp
WHATSAPP_API_KEY=

# Server
PORT=4000
NODE_ENV=development

# Public API URL used in Swagger when not auto-detected (optional)
# Example Docker: http://localhost:4000
# Example via admin proxy: http://localhost:3000
API_BASE_URL=

# Testing (optional — overrides DATABASE_URL during npm test)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/blinkit?schema=public
OTP_TEST_CODE=123456

# Seed
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=admin@123
SUPER_ADMIN_NAME=Super Admin
