# Local backend — copy to .env or use SKIP_SECRETS_MANAGER=1 with these values.
# Production: store the same keys in AWS Secrets Manager JSON.

NODE_ENV=development
PORT=4000
SKIP_SECRETS_MANAGER=1

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/blinkit?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

DEFAULT_STORE_ID=

# OTP — static free mode (M1 default). Use 123456 for any phone.
OTP_SMS_PROVIDER=static
OTP_STATIC_CODE=123456

# Google OAuth (Sign-In) — same Client ID as user-web NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Apple Sign-In — Services ID (same as NEXT_PUBLIC_APPLE_CLIENT_ID)
APPLE_CLIENT_ID=

# Google Maps Places API — address search (enable Places API in Google Cloud)
MAPS_API_KEY=

# Optional: S3 uploads, admin seed overrides
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
