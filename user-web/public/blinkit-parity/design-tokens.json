{
  "meta": {
    "source": "blinkit.com vendor/main CSS + layout.js styled-components",
    "wayback_ts": "20260814115632"
  },
  "colors": {
    "brandYellow": "#F8CB46",
    "cartGreen": "#0C831F",
    "cartGreenHover": "#097019",
    "text": "#1F1F1F",
    "textDark": "#333333",
    "textMuted": "#363636",
    "textGray": "#666666",
    "placeholder": "#999999",
    "divider": "#EEEEEE",
    "dividerSoft": "#F2F2F2",
    "searchBg": "#F8F8F8",
    "searchBorder": "#E8E8E8",
    "headerHover": "#FCFCFC",
    "overlayLogin": "rgba(0,0,0,0.7)",
